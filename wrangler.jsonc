// Cloudflare settings for jeselleva.com (Netlify ignores this file).
{
  "name": "jeselle-portfolio",
  "main": "cloudflare/worker.mjs",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "public", "binding": "ASSETS", "html_handling": "none", "not_found_handling": "404-page", "run_worker_first": ["/api/*", "/", "/facebook", "/messenger"] },
  "alias": { "@netlify/blobs": "./cloudflare/blobs.mjs", "nodemailer": "./cloudflare/mail.mjs", "web-push": "./cloudflare/webpush.mjs" },
  "d1_databases": [{ "binding": "DB", "database_name": "jeselle-crm" }],
  "kv_namespaces": [{ "binding": "FILES" }],
  "triggers": { "crons": ["*/15 * * * *", "0 1 * * *", "0 1 1 * *"] },
  "vars": { "SITE_URL": "https://jeselleva.com", "GMAIL_USER": "bariljeselle@gmail.com" },
  "observability": { "enabled": true }
}
